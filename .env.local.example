# Msg91 WhatsApp API credentials
# Get your Auth Key from https://msg91.com/integrations
# Create a WhatsApp template with variables for name, email, restaurant, locations, message
NEXT_PUBLIC_MSG91_AUTHKEY=your_msg91_auth_key_here
NEXT_PUBLIC_MSG91_TEMPLATE_ID=your_template_id_here

# Google Analytics 4 (GA4) Measurement ID
# Get your Measurement ID from https://analytics.google.com/
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_ga_measurement_id_here

# Search Engine Verification
# Google Search Console verification code
# Get from https://search.google.com/search-console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification_code_here

# Bing Webmaster Tools verification code
# Get from https://www.bing.com/webmasters
NEXT_PUBLIC_BING_SITE_VERIFICATION=your_bing_verification_code_here
